<head>
    <title>{{ item.title }} regex · {{ data.site.name }}</title>
    <meta name="description" content="{{ item.title }}: {{ item.explain }}">
    <meta property="og:title" content="{{ item.title }} regex · {{ data.site.name }}">
    <meta property="og:description" content="{{ item.title }}: {{ item.explain }}">
</head>

<template>
<div class="wrap" id="libItem" data-pattern="{{ item.pattern }}" data-flags="{{ item.flags }}">
  <p class="crumbs"><a href="/"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>সব pattern</a></p>

  <section class="page-head">
    <span class="tag {{ item.category }}">{{ item.category === 'bd' ? 'বাংলাদেশি' : 'সাধারণ' }}</span>
    <h1>{{ item.title }}</h1>
    <p>{{ item.explain }}</p>
  </section>

  <section class="card detail-main">
    <PatternCode text="/{{ item.pattern }}/{{ item.flags }}" class="big" />
    <div class="detail-actions">
      <a class="btn primary" href="/playground/#p={{ encodeURIComponent(item.pattern) }}&f={{ encodeURIComponent(item.flags + 'gm') }}&t={{ encodeURIComponent(item.should_match.join('\n') + '\n' + item.should_not_match.join('\n')) }}">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 4.5v15l12-7.5z" fill="currentColor"/></svg>
        Playground-এ খুলুন
      </a>
    </div>
    <template if="item.notes">
      <p class="detail-note">{{ item.notes }}</p>
    </template>
  </section>

  <div class="grid-2">
    <section class="card">
      <h2>যা মিলবে</h2>
      <div class="ex-list">
        <template for="t in item.should_match">
          <span class="ex yes">{{ t }}</span>
        </template>
      </div>
    </section>
    <section class="card">
      <h2>যা মিলবে না</h2>
      <div class="ex-list">
        <template for="t in item.should_not_match">
          <span class="ex no">{{ t === '' ? '(খালি লেখা)' : t }}</span>
        </template>
      </div>
    </section>
  </div>

  <section class="card">
    <h2>নিজে পরীক্ষা করুন</h2>
    <div class="tester-row">
      <input class="tester" id="tester" type="text" spellcheck="false" autocomplete="off" placeholder="এখানে একটা লেখা দিন" aria-label="পরীক্ষার লেখা">
      <span class="tester-out" id="testerOut" aria-live="polite"></span>
    </div>
  </section>

  <section class="card">
    <h2>কোড</h2>
    <div class="utabs-row code-tabs">
      <div class="utabs" id="codeTabs" role="tablist">
        <button type="button" class="chip on" data-lang="js">JavaScript</button>
        <button type="button" class="chip" data-lang="php">PHP</button>
        <button type="button" class="chip" data-lang="laravel">Laravel</button>
        <button type="button" class="chip" data-lang="python">Python</button>
      </div>
    </div>
    <div class="code-block">
      <button type="button" class="btn small" id="codeCopy">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="lbl">কপি</span>
      </button>
      <pre id="codeOut"><code></code></pre>
    </div>
    <div id="codeNotes"></div>
  </section>
</div>
</template>

<script>
(function () {
    var root = document.getElementById('libItem');
    var U = window.RegexUtil;
    var pattern = root.dataset.pattern;
    var flags = root.dataset.flags;
    var re = new RegExp(pattern, flags.replace(/[gy]/g, ''));
    var tester = document.getElementById('tester');
    var out = document.getElementById('testerOut');

    tester.addEventListener('input', function () {
        if (tester.value === '') { out.innerHTML = ''; return; }
        var ok = re.test(tester.value);
        out.innerHTML = ok ? '<span class="ex yes">মিলেছে</span>' : '<span class="ex no">মেলেনি</span>';
    });

    var code = null;
    var lang = 'js';
    var pre = document.querySelector('#codeOut code');
    var notes = document.getElementById('codeNotes');

    function render() {
        if (!code) return;
        pre.textContent = code[lang];
        notes.innerHTML = (code.notes[lang] || []).map(function (n) { return '<p class="code-note">ⓘ ' + U.escapeHtml(n) + '</p>'; }).join('');
    }

    window.RegexEngine.call('codegen', { pattern: pattern, flags: flags, mode: 'match', replacement: '' }).then(function (result) {
        code = result;
        render();
    });

    document.getElementById('codeTabs').addEventListener('click', function (event) {
        var btn = event.target.closest('button[data-lang]');
        if (!btn) return;
        lang = btn.dataset.lang;
        document.querySelectorAll('#codeTabs button').forEach(function (b) { b.classList.toggle('on', b === btn); });
        render();
    });
    document.getElementById('codeCopy').addEventListener('click', function () {
        var btn = document.getElementById('codeCopy');
        U.copy(pre.textContent).then(function (ok) {
            var label = btn.querySelector('.lbl');
            label.textContent = ok ? 'কপি হয়েছে ✓' : 'কপি হয়নি';
            setTimeout(function () { label.textContent = 'কপি'; }, 1400);
        });
    });
})();
</script>
