{
    "title": "IPv4 ঠিকানা",
    "category": "common",
    "pattern": "^(?:(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)$",
    "flags": "",
    "explain": "ডট দিয়ে আলাদা চারটা অংশ, প্রতিটা 0 থেকে 255। 256 বা 999 যাতে না মেলে, তাই প্রতিটা সীমা আলাদা শাখায় লেখা।",
    "should_match": [
        "192.168.0.1",
        "255.255.255.255",
        "0.0.0.0",
        "10.0.0.254"
    ],
    "should_not_match": [
        "256.1.1.1",
        "1.2.3",
        "1.2.3.4.5",
        "01.2.3.4"
    ],
    "notes": "\\d{1,3} লিখলে 999.999.999.999-ও পাস করত। তাই প্রতিটা সীমা আলাদা করে লেখা।",
    "order": 18
}
