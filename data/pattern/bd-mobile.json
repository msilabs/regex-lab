{
    "title": "বাংলাদেশি মোবাইল নম্বর",
    "category": "bd",
    "pattern": "^(?:\\+?88)?01[3-9]\\d{8}$",
    "flags": "",
    "explain": "শুরুতে +88 বা 88 থাকতে পারে, তারপর 01, তারপর 3 থেকে 9-এর একটা অঙ্ক, তারপর আরো ৮টা অঙ্ক।",
    "should_match": [
        "01712345678",
        "+8801812345678",
        "8801912345678",
        "01312345678"
    ],
    "should_not_match": [
        "01212345678",
        "0171234567",
        "017123456789",
        "+8701712345678"
    ],
    "notes": "013/017 গ্রামীণফোন, 014/019 বাংলালিংক, 016/018 রবি, 015 টেলিটক। 012 বা 010 দিয়ে কোনো নম্বর শুরু হয় না।",
    "order": 1
}
